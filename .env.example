# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# For Vercel production deployment, add GEMINI_API_KEY in Vercel Project Settings -> Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional compatible fallback Gemini model used only after primary retries fail:
# GEMINI_FALLBACK_MODEL="gemini-3.1-flash-lite"

# Optional Web Push (VAPID) keys for encrypted background push notifications.
# Generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:your-email@example.com"

# Optional secret for securing /api/push/cron in Vercel Cron Jobs
# CRON_SECRET=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
